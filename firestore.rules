rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /versions/{versionId} {
    	function isAdmin(){
      	return request.auth != null && get(/databases/$(database)/documents/versions/$(versionId)/users/$(request.auth.uid)).data.type == 'admin';
      }
      
      function isAuth(){
      	return request.auth != null
      }
    
      allow read: if true;
      
			match /users/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /animes/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
        match /comments/{commentId} {
          allow write: if isAuth();
        }
        match /ratings/{ratingType}/userRatings/{ratingId} {
          allow write: if isAuth();
        }
      }
      
      match /tags/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Tags a script has proposed and nobody has approved yet. Admin-only in
      // both directions: this is what a model said, not what the site says, and
      // the read above does not reach here — a subcollection is unmatched, and
      // therefore denied, until it is named.
      match /tagProposals/{document=**} {
        allow read, write: if isAdmin();
      }

      // API key hashes. Unmatched paths are denied by default, but state it
      // explicitly: these must only ever be touched by the Admin SDK from the
      // route handlers, never by a client.
      match /apiKeys/{document=**} {
        allow read, write: if false;
      }
    }
  }
}